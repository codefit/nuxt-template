# ─── Public (exposed to client via runtimeConfig.public) ───
# Nuxt maps NUXT_PUBLIC_* → useRuntimeConfig().public.*

# Canonical site origin — no trailing slash (SEO, OG, sitemap, i18n baseUrl)
NUXT_PUBLIC_SITE_URL=https://www.example.com

# Default app locale (`cs` | `sk` | `en`) — also accepted as NUXT_LOCALE_DEFAULT
NUXT_PUBLIC_DEFAULT_LOCALE=cs

# Google Tag Manager container (empty = dataLayer only, no GTM script)
NUXT_PUBLIC_GTM_ID=

# reCAPTCHA v3 site key (public) — https://www.google.com/recaptcha/admin
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ─── Private server (optional / production) ───
# NUXT_*=useRuntimeConfig() top-level keys when you add them

# Resend — https://resend.com/api-keys (never expose to client)
NUXT_RESEND_API_KEY=

# reCAPTCHA v3 secret (private) + optional min score (default 0.5)
NUXT_RECAPTCHA_SECRET_KEY=
NUXT_RECAPTCHA_MIN_SCORE=0.5

# Session cookie encryption (nuxt-auth-utils) — min 32 characters
# Generated automatically in `nuxt dev` if missing; set explicitly in production.
NUXT_SESSION_PASSWORD=

# Allow dashboard self-registration (default off):
# NUXT_PUBLIC_AUTH_ALLOW_REGISTER=true

# Seed admin account overrides (defaults: admin@example.com / Admin123!)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=Admin123!
# SEED_ADMIN_NAME=Admin

# ─── Database (NuxtHub PostgreSQL) ───
# Local without URL → PGlite. Railway / Neon → set connection string.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── NuxtHub (Cloudflare) — uncomment when linking a Hub project ───

# NUXT_HUB_PROJECT_URL=
# NUXT_HUB_PROJECT_SECRET_KEY=

# ─── Usage ───
# 1. Copy this file:
#      cp .env.example .env.local
# 2. Adjust values for your machine / environment
# 3. Never commit .env / .env.local / .env.*.local
#
# Nuxt loads `.env` by default (also `.env.local` if you pass `--dotenv .env.local`).
# Put local secrets in `.env` or `.env.local` (both gitignored).
